# Copy to .env.local for local runs. Do not commit real secrets.
DATABASE_URL=
LEAD_NOTIFY_EMAIL=acadianabathandcounter@gmail.com,shaun.brasher@gmail.com,shaun@lagniapperealmlabs.com
RESEND_API_KEY=
RESEND_FROM=
# Optional. When set, lead emails embed a Street View photo of the house.
# Street View Static API. Without it, the email still links to Street View / Maps.
# Do not put a Google Places key here — address suggestions use ArcGIS (no key).
GOOGLE_MAPS_API_KEY=

# Gigi chat. Same key the design tool uses. Never commit a real key.
XAI_API_KEY=
# Optional model id. Defaults to the design vision model.
# CHAT_MODEL=grok-4.20-0309-non-reasoning
# Daily estimated spend cap in dollars. 0 turns the model off and uses the scripted reply.
# CHAT_DAILY_USD_CAP=5

# Search indexing. Leave unset or false on the preview.
# Set to true and redeploy only after Shaun says go-live.
SITE_INDEXABLE=false
# Optional canonical origin. Defaults to the Render preview URL.
# SITE_URL=https://acadiana-bathrooms.onrender.com
